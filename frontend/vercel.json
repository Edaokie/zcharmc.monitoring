{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "ignoreCommand": "exit 1",
  "git": { "deploymentEnabled": true },
  "github": { "autoJobCancelation": false },
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://zcharmcmonitoring-production.up.railway.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/backend/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ],
  "build": {
    "env": {
      "NITRO_PRESET": "vercel",
      "VITE_BACKEND_URL": "https://zcharmcmonitoring-production.up.railway.app"
    }
  }
}
