DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://zcharmc:zcharmc@localhost:5432/zcharmc
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://zcharmc-monitoring.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://zcharmc-monitoring.vercel.app
# Keep false: browsers now authenticate with Django sessions.
ALLOW_PUBLIC_READ=false
INGEST_API_KEY=replace-with-a-different-long-random-secret
# PostgreSQL is required for development, tests and production.

# Exact public PEM from firmware/keys/release-public.pem; optional until OTA is enabled.
# Escaped \n newlines are accepted. Never put the private signing key here.
OTA_SIGNING_PUBLIC_KEY=
# Match this random, dedicated secret in the GitHub firmware-release environment.
# Registration cannot enable releases or assign devices. Empty disables the endpoint.
OTA_RELEASE_REGISTRATION_KEY=
OTA_RELEASE_REPOSITORY=Edaokie/zcharmc.monitoring
