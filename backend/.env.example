DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://zcharmc:zcharmc@localhost:5432/zcharmc
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://zcharmc-monitoring.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://zcharmc-monitoring.vercel.app
# Local default. The approved cloud demo enables public reads while login remains mocked.
ALLOW_PUBLIC_READ=false
INGEST_API_KEY=replace-with-a-different-long-random-secret
# Only for local development without PostgreSQL: unset DATABASE_URL and set ALLOW_SQLITE=true.
